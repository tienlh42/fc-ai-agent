APP_HOST=127.0.0.1
APP_PORT=8010
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
EMBEDDING_MODEL=embeddinggemma
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
MAX_TOOL_ROUNDS=5

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=local_documents
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_OUTPUT_TOKENS=256
DOCUMENT_STORAGE_DIR=./data/documents
DOCUMENT_MAX_FILE_SIZE_MB=20

EXTERNAL_API_BASE_URL=http://localhost:8080/
DOCKER_EXTERNAL_API_BASE_URL=http://host.docker.internal:8080/
EXTERNAL_API_KEY=replace-with-your-api-key
EXTERNAL_API_KEY_HEADER=Api-Key
EXTERNAL_API_TIMEOUT=15
